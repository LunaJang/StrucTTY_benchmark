--- a/src/structure/FoldseekDBReader.cpp
+++ b/src/structure/FoldseekDBReader.cpp
@@ -1,5 +1,6 @@
 #include "FoldseekDBReader.hpp"
 #include <cstring>
 #include <cstdlib>
 #include <iostream>
+#include <cstdio>

@@ -146,6 +147,22 @@ bool FoldseekDBReader::prepare(const std::unordered_set<std::string>& target_ids
     if (!opened_) return false;
     if (target_ids.empty()) return true;

+    // ── RSS measurement: before ──────────────────────────────────────────
+    auto read_rss_kb = []() -> long {
+        FILE* f = std::fopen("/proc/self/status", "r");
+        if (!f) return -1;
+        char buf[256];
+        long rss = -1;
+        while (std::fgets(buf, sizeof(buf), f)) {
+            if (std::strncmp(buf, "VmRSS:", 6) == 0) {
+                std::sscanf(buf + 6, "%ld", &rss);
+                break;
+            }
+        }
+        std::fclose(f);
+        return rss;  // in KB
+    };
+    long rss_before = read_rss_kb();
+    // ─────────────────────────────────────────────────────────────────────
+
     std::cout << "  Scanning Foldseek DB for " << target_ids.size() << " targets...\n";

     // 단계 1: .lookup 스캔
@@ -172,6 +189,16 @@ bool FoldseekDBReader::prepare(const std::unordered_set<std::string>& target_ids
     std::cout << "    seq_index: " << seq_index_.size() << " entries\n";

     std::cout << "  Foldseek DB ready.\n";
+
+    // ── RSS measurement: after ───────────────────────────────────────────
+    long rss_after = read_rss_kb();
+    if (rss_before >= 0 && rss_after >= 0) {
+        long delta = rss_after - rss_before;
+        std::cout << "  [mem] RSS before : " << rss_before << " KB\n";
+        std::cout << "  [mem] RSS after  : " << rss_after  << " KB\n";
+        std::cout << "  [mem] RSS delta  : " << delta << " KB"
+                  << "  (for " << target_ids.size() << " targets,"
+                  << " ~" << (target_ids.size() > 0 ? delta * 1024 / (long)target_ids.size() : 0)
+                  << " bytes/entry)\n";
+    }
+    // ─────────────────────────────────────────────────────────────────────
+
     return true;
 }
